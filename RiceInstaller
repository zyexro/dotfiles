}

add_void_repos() {
    clear
    logo "Enabling Void repositories"
    sleep 2

    printf "%b\n" "${BLD}${CYE}Enabling ${CBL}nonfree${CYE} and ${CBL}multilib${CYE} repositories...${CNC}"

    sudo xbps-install -S --yes void-repo-nonfree void-repo-multilib
    sudo xbps-install -S
    sleep 3
}

install_dependencies() {
    clear
    logo "Installing needed packages from Void repositories..."
    sleep 2

    sudo xbps-install -S
    # Fonts follow Void naming (`*-ttf`); `nerd-fonts-ttf` covers the mono Nerd
    # glyphs the rices use. Individually named Arch font packages don't exist here.
    dependencies="alacritty base-devel bat bc brightnessctl bspwm clipcat dunst eza feh fzf thunar tumbler gvfs-mtp firefox geany git imagemagick jq jgmenu kitty libwebp maim mpc mpd mpv neovim xcolor ncmpcpp npm pamixer papirus-icon-theme picom playerctl polybar lxsession python3-gobject redshift rofi rustup sxhkd xclip xdg-user-dirs xdo xdotool xsettingsd xdpyinfo xkill xprop xrandr xsetroot xwininfo xrdb yazi zsh zsh-autosuggestions zsh-history-substring-search zsh-syntax-highlighting simple-mtpfs dejavu-fonts-ttf nerd-fonts-ttf webp-pixbuf-loader"

    # Arrays temporales
    failed_deps=""
    retry_failed=""

    # First pass
    for pkg in $dependencies; do
        sleep 0.50
        if ! sudo xbps-install -S -y "$pkg"; then
            failed_deps="$failed_deps $pkg"
        fi
    done

    # If there were failures, try again
    if [ -n "$failed_deps" ]; then
        printf "\n%b\n" "${BLD}${CRE}These dependencies failed:${CYE}${failed_deps}${CNC}"
        printf "%b\n\n" "${BLD}${CYE}Retrying installation..${CNC}"

        for pkg in $failed_deps; do
            sleep 0.50
            if ! sudo xbps-install -S -y "$pkg"; then
                retry_failed="$retry_failed $pkg"
            fi
        done
    fi

    # Final Result
    if [ -n "$retry_failed" ]; then
        printf "\n%b\n" "${BLD}${CRE}These dependencies could not be installed after two attempts:${CYE}${retry_failed}${CNC}"
        printf "%b\n\n" "${BLD}${CBL}missing_apps.txt ${CYE}file was created on your ${CGR}HOME ${CYE}with the list."
        printf "The following dependencies failed, please install manually:\n%s\n" "$retry_failed" > missing_apps.txt
    else
        if [ -z "$failed_deps" ]; then
            printf "\n%b\n" "${BLD}${CGR}All dependencies were installed successfully.${CNC}"
        else
            printf "\n%b\n" "${BLD}${CGR}All dependencies were installed successfully after retry${CNC}"
        fi
    fi
    sleep 3
}

