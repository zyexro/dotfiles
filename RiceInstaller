    clear
    logo "Packages not in Void repos"
    sleep 2

    printf "%b\n" "${BLD}${CYE}These rice-specific packages are (mostly) Arch/AUR-only and are not available${CNC} ${BLD}${CYE}from the xbps repositories:${CNC}"
    printf "%b\n" "  st-gh0stzk, gh0stzk-gtk-themes, gh0stzk-cursor-qogirr, gh0stzk-icons-*,"
    printf "%b\n" "  i3lock-color, eww-git, fzf-tab-git, xwinwrap."
    printf "\n%b\n" "${BLD}${CBL}Build and install them from the Void source tree:${CNC}"
    printf "%b\n" "  git clone https://github.com/void-linux/void-packages.git ~/void-packages"
    printf "%b\n" "  (cd ~/void-packages && ./xbps-src binary-bootstrap && ./xbps-src pkg <template> && sudo xbps-install -R ~/void-packages/hostdir/binpkgs <pkg>)"
    printf "%b\n" "  Alternatively build the helper ${CYE}xi${CNC} from void-packages for one-liner builds:"
    printf "\n%b\n" "  sudo xbps-install xi && xi i3lock-color eww fzf-tab"
