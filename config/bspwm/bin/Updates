#!/bin/sh
# =============================================================
# Author: gh0stzk
# Repo:   https://github.com/gh0stzk/dotfiles
# Date:   06.04.2025 09:41:28
#
# Updates - Script to check for new updates (Void Linux / xbps)
#           and sync updates module in polybar/Eww.
# Features:
#   ✔ Shows the number of updates available in polybar/eww
#   ✔ Used by the update timer/cron to refresh the polybar-module/eww-poll. --sync-polybar
#
# Dependencies:
#   → xbps, polybar
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

UPDATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/Updates.txt"

# Sync bars when needed.
sync_bars() {
    local current_rice

    # Sends the signal to polybar-module/eww-poll to update the data.
    if pgrep -x polybar >/dev/null; then
        polybar-msg action updates hook 0 >/dev/null 2>&1
    else
        read -r current_rice < "$HOME/.config/bspwm/.rice"
        eww -c "$HOME/.config/bspwm/rices/${current_rice}/bar" poll UPDATES
    fi
}

# Single source of truth for counting
get_updates() {
    tmp=$(mktemp) || return 1

    # Refresh the repo index non-interactively if we can (timer/cron); fall
    # back to the last synced index otherwise. xbps-install -un prints each
    # updatable package plus a trailing "N to update" summary line.
    sudo -n xbps-install -S >/dev/null 2>&1
    xbps-install -un 2>/dev/null >"$tmp"

    official_updates=$(grep -v ' to update' "$tmp" | grep -v '^[[:space:]]*$')
    total=$(grep -m1 ' to update' "$tmp" | grep -o '[0-9]\+' | head -1)
    rm -f "$tmp"

    total=${total:-0}
}

# Persist the last successful result (count) and sync bars
persist_results() {
    printf '%s\n' "$total" > "$UPDATE_FILE"
    sync_bars
}

# Main verification function
check_updates() {
    # If get_updates fails (e.g. no network yet), keep the last cached
    get_updates && persist_results
}

list_updates() {
    if get_updates; then
        persist_results
        offline=0
    else
        total=$(cat "$UPDATE_FILE" 2>/dev/null)
        offline=1
    fi

    total=${total:-0}

    if [ "$total" -gt 0 ]; then
        printf "\033[1m\033[33mThere are %s updates available:\033[0m\n" "$total"

        if [ "$offline" -eq 1 ]; then
            printf "\n\033[1m\033[31mNo internet connection.\033[0m\n"
        else
            if [ -n "$official_updates" ]; then
                printf "\n\033[1m\033[34mAvailable updates:\033[0m\n"
                printf '%s\n' "$official_updates" | sed 's/->/\x1b[32;1m\x1b[0m/g'
            fi
        fi
    else
        if [ "$offline" -eq 1 ]; then
            printf "\033[1m\033[31mNo internet connection.\033[0m\n"
        else
            printf "\033[1m\033[32mYour system is already updated!\033[0m\n"
        fi
    fi
}

# Execute it accordingly
case "$1" in
    --sync-polybar)
        check_updates ;;
    --print-updates)
        list_updates
        printf '\n\033[2mPress Enter to close...\033[0m\n'
        read -r _ </dev/tty 2>/dev/null ;;
    *)
        printf '%s [OPTIONS]\n' "${0##*/}"
        printf '%s\n' "  --sync-polybar      Sync data & polybar module"
        printf '%s\n' "  --print-updates     Sync data, polybar module & print available apps to update"
        exit 1
    ;;
esac
